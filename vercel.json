{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/ai.js",    "use": "@vercel/node" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "public/**",    "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/ai",      "dest": "/api/ai.js" },
    { "src": "/api/health",  "dest": "/api/health.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)",        "dest": "/public/$1" }
  ]
}
